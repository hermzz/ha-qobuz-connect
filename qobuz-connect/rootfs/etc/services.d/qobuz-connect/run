#!/usr/bin/with-contenv bashio
# ==============================================================================
# Start the example service
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
declare -a options
declare name
declare password
declare username

username=$(bashio::config 'username')
password=$(bashio::config 'password')

/usr/bin/qobuz-player config username "${username}"
/usr/bin/qobuz-player config password "${password}"

options+=(-d)
options+=(--disable-mpris)
options+=(--connect)

name=$(bashio::config 'name')
options+=(--connect-name "${name}")

exec /usr/bin/qobuz-player open "${options[@]}"